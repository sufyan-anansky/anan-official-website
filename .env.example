# Copy this file to .env.local and fill in your mailbox credentials.
# Restart the dev server after changing these values.
# Do not commit .env.local.

# SMTP server, for example smtp.office365.com or smtp.gmail.com
SMTP_HOST=smtp.gmail.com
# 587 for STARTTLS, 465 for implicit TLS
SMTP_PORT=587
# true for port 465, false for port 587
SMTP_SECURE=false
SMTP_USER=info@anansky.net
SMTP_PASSWORD=your-app-password
# Must be an address your SMTP provider allows this account to send from
SMTP_FROM="Anan Sustainability <noreply@anansky.net>"

# Inbox that receives contact form inquiries
CONTACT_TO_EMAIL=info@anansky.net
